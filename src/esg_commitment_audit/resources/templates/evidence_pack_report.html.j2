<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>AI Revisability Evidence-Pack Assessment</title>
  <style>
    :root { --ink:#15211f; --muted:#60706b; --line:#dce1dc; --paper:#f4f2ec; --accent:#0f766e; --good:#d9f0ea; --warn:#fff0d7; --bad:#fde7e7; }
    * { box-sizing:border-box; }
    body { margin:0; color:var(--ink); background:var(--paper); font-family:"Segoe UI","Microsoft YaHei",sans-serif; line-height:1.55; }
    main { max-width:1180px; margin:0 auto; padding:42px 24px 64px; }
    header, section.card { background:#fff; border:1px solid var(--line); border-radius:16px; padding:24px; margin-bottom:16px; }
    h1 { margin:4px 0 8px; font-family:Georgia,"Songti SC",serif; font-size:2.5rem; }
    h2 { margin:4px 0 16px; }
    .eyebrow { color:var(--accent); font-size:.72rem; font-weight:800; letter-spacing:.14em; text-transform:uppercase; }
    .muted { color:var(--muted); }
    table { width:100%; border-collapse:collapse; font-size:.82rem; margin:8px 0 18px; }
    th, td { border:1px solid var(--line); text-align:left; padding:8px; vertical-align:top; }
    th { background:#f5f7f3; }
    .pill { display:inline-block; border-radius:999px; padding:2px 8px; font-size:.68rem; font-weight:800; }
    .good { color:var(--accent); background:var(--good); }
    .warn { color:#7d5d14; background:var(--warn); }
    .bad { color:#8b2d20; background:var(--bad); }
    footer { color:var(--muted); font-size:.78rem; margin-top:22px; }
    @media(max-width:700px) { main { padding:24px 12px 40px; } table { display:block; overflow-x:auto; } }
  </style>
</head>
<body>
<main>
  <header>
    <p class="eyebrow">ICS-TEC · Evidence-Pack Assessment · {{ report.report_version }}</p>
    <h1>AI Revisability Evidence-Pack Assessment</h1>
    <p><strong>{{ report.organization }}</strong> · Review date {{ report.reviewed_at.isoformat() }} · Profile {{ report.profile }}</p>
    <p class="muted">Base document: {{ report.base_document }} · SHA-256 {{ report.base_document_sha256 }}</p>
  </header>

  <section class="card">
    <h2>Artifact inventory</h2>
    <table>
      <thead><tr><th>Artifact</th><th>Type</th><th>Issuer</th><th>Issued</th><th>Hash</th><th>E3 eligible</th><th>Warnings</th></tr></thead>
      <tbody>
      {% for item in report.artifact_inventory %}
        <tr>
          <td><code>{{ item.path }}</code></td>
          <td>{{ item.artifact_type }}</td>
          <td>{{ item.issuer or "—" }}</td>
          <td>{{ item.issued_at or "—" }}</td>
          <td>{{ "matched" if item.hash_matches is true else "mismatch" if item.hash_matches is false else "not pinned" }}</td>
          <td>{{ item.eligible_for_operational_evidence }}</td>
          <td>{{ item.warnings | join("; ") or "—" }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </section>

  <section class="card">
    <h2>Proposed evidence-grade promotions</h2>
    <table>
      <thead><tr><th>Control</th><th>Baseline</th><th>Proposed</th><th>Supporting artifacts</th><th>Human confirmation</th></tr></thead>
      <tbody>
      {% for item in report.promotions %}
        <tr>
          <td><code>{{ item.check_key }}</code></td>
          <td><span class="pill warn">{{ item.baseline_grade.value }}</span></td>
          <td><span class="pill good">{{ item.proposed_grade.value }}</span></td>
          <td>{{ item.supporting_artifacts | join(", ") }}</td>
          <td>{{ item.requires_human_confirmation }}</td>
        </tr>
      {% else %}
        <tr><td colspan="5">No promotion proposed.</td></tr>
      {% endfor %}
      </tbody>
    </table>
  </section>

  <section class="card">
    <h2>Remaining evidence gaps</h2>
    <ul>
    {% for item in report.unresolved_controls %}
      <li><code>{{ item.check_key }}</code> ({{ item.baseline_grade.value }}) needs {{ item.missing_artifact_types | join(", ") }}</li>
    {% else %}
      <li>No mapped evidence gaps.</li>
    {% endfor %}
    </ul>
  </section>

  {% if report.warnings %}
  <section class="card">
    <h2>Warnings</h2>
    <ul>{% for item in report.warnings %}<li>{{ item }}</li>{% endfor %}</ul>
  </section>
  {% endif %}

  <section class="card">
    <h2>Claim boundary</h2>
    <p>{{ report.disclaimer }}</p>
  </section>
  <footer>Copyright 2026 Xue Zhi Xin (ICS-TEC) · Apache License 2.0 · {{ report.report_version }}</footer>
</main>
</body>
</html>
