{
  "mcpServers": {
    "esg-commitment-audit": {
      "cwd": ".",
      "command": "node",
      "args": [
        "server.mjs"
      ],
      "env": {
        "ESG_AUDIT_API_URL": "https://esg-commitment-audit-api.franka328162810.workers.dev",
        "NODE_NO_WARNINGS": "1"
      },
      "env_vars": [
        "ESG_AUDIT_API_KEY"
      ],
      "startup_timeout_sec": 20,
      "tool_timeout_sec": 300,
      "tools": {
        "audit_document": {
          "approval_mode": "prompt"
        },
        "audit_text": {
          "approval_mode": "prompt"
        },
        "delete_cloud_audit": {
          "approval_mode": "prompt"
        }
      }
    }
  }
}
