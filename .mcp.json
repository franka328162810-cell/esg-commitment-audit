{
  "mcpServers": {
    "esg-commitment-audit": {
      "command": "python",
      "args": [
        "-m",
        "esg_commitment_audit.mcp_server"
      ],
      "cwd": ".",
      "env": {
        "PYTHONPATH": "./src"
      },
      "env_vars": [
        "ESG_AUDIT_API_URL",
        "ESG_AUDIT_API_KEY"
      ],
      "startup_timeout_sec": 20,
      "tool_timeout_sec": 900,
      "tools": {
        "submit_cloud_audit": {
          "approval_mode": "prompt"
        }
      }
    }
  }
}
